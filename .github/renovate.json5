{
  // The settings the XWiki repositories share. See https://github.com/xwiki/.github
  "extends": ["github>xwiki/.github//renovate/default.json5"],

  // Skip Eclipse M2E special setup "dependency"
  // Skip jdom 1 since jdom 2 actually use a different id now
  // antlr 2 is not maintained anymore
  // Renovate replaces the preset's "ignoreDeps" with this one rather than merging them, so the
  // entry the preset already holds has to be repeated here.
  "ignoreDeps": ["org.eclipse.m2e:lifecycle-mapping", "org.jdom:jdom", "antlr:antlr"],

  // Assign all upgrade pull requests by default to the one in charge of dispatching them
  assignees: [
    "tmortagne"
  ],

  // Added to the rules of the preset, which already disables the commons, rendering and platform dependencies.
  "packageRules": [
    // Add the URL to the XWiki Nexus public proxy. In theory, it's useless for xwiki-commons which only depends on Maven Central, but in practice Maven Central regularly block Renovate, so we use nexus.xwiki.org as fallback.
    {
      "matchDatasources": ["maven"],
      // The direct Maven Central access is rejecting Mend Renovate way too often to be usable these days ("too many requests")
      // "registryUrls": ["https://repo1.maven.org/maven2/", "https://nexus.xwiki.org/nexus/content/repositories/central/"]
      "registryUrls": ["https://nexus.xwiki.org/nexus/content/repositories/central/"]
    },

    // Ignore Byte Buddy versions ending with -jdk5 (they only make sense for project which need to support Java < 8)
    {
      "matchPackageNames": ["net.bytebuddy:*"],
      "allowedVersions": "!/-jdk5$/"
    },

    // maven.build.version and maven.resolver.build.version are the versions of Maven and Maven Resolver used to build
    // XWiki and its Maven plugins, they must not be upgraded just because a more recent version exists. The versions to
    // keep up to date are the ones embedded in the XWiki runtime (maven.runtime.version and
    // maven.resolver.runtime.version), tracked by the custom managers below.
    {
      "matchManagers": ["maven"],
      "matchJsonata": ["sharedVariableName in ['maven.build.version', 'maven.resolver.build.version']"],
      "enabled": false
    }
  ],

  // Track the versions of Maven and Maven Resolver embedded in the XWiki runtime (they are used in xwiki-platform,
  // where the distribution sets maven.version and maven.resolver.version to them).
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": ["<maven\\.runtime\\.version>(?<currentValue>[^<]+)</maven\\.runtime\\.version>"],
      "depNameTemplate": "org.apache.maven:maven-core",
      "datasourceTemplate": "maven"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pom\\.xml$/"],
      "matchStrings": [
        "<maven\\.resolver\\.runtime\\.version>(?<currentValue>[^<]+)</maven\\.resolver\\.runtime\\.version>"
      ],
      "depNameTemplate": "org.apache.maven.resolver:maven-resolver-api",
      "datasourceTemplate": "maven"
    }
  ]
}
