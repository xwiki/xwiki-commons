<infinispan
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="urn:infinispan:config:16.2 https://infinispan.org/schemas/infinispan-config-16.2.xsd"
      xmlns="urn:infinispan:config:16.2">

   <cache-container name="xwiki" default-cache="default">
     <!-- Thresholds that can't be reached so that the monitor never logs anything during the tests. -->
     <memory-monitor enabled="true" memory-threshold="1.0" gc-duration-threshold="3600000"
        gc-pressure-threshold="1.0"/>

     <local-cache-configuration name="default">
        <memory max-count="10000"/>
     </local-cache-configuration>
   </cache-container>
</infinispan>
